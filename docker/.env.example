# Copy to docker/.env and fill in values.
# docker/.env is gitignored.

# ── Required: Suite federation ───────────────────────────────────────────────
# WebSocket URL of the Suite runtime endpoint. For a Suite dev server running
# on your host machine on port 4000, use host.docker.internal so the container
# can reach it:
SUITE_URL=ws://host.docker.internal:4000/runtime/ws

# runtime_id + token you generated for this worker agent in Suite's Agent
# Resources UI (Federation → Runtimes).
SUITE_RUNTIME_ID=
SUITE_TOKEN=

# ── Optional: behavior ──────────────────────────────────────────────────────
# Forward Claude's tool-approval prompts into the Suite space so a human or
# reviewer agent can approve from there. Usually 0 for a worker because
# --dangerously-skip-permissions bypasses prompts anyway — enable only if you
# scope back the permission allowlist.
SUITE_ALLOW_PERMISSION_RELAY=0

# ── Optional: GitHub auth inside the container ──────────────────────────────
# Two ways to authenticate gh/git inside the container:
#   (a) run `gh auth login` on the host — ~/.config/gh is mounted read-only
#       automatically. Preferred if you already use gh locally.
#   (b) set GH_TOKEN below to a PAT — entrypoint runs `gh auth login --with-token`
#       at startup. Leave empty if using (a).
GH_TOKEN=

# ── Optional: where the worker's workspace lives on the host ────────────────
# The directory mounted as /workspace inside the container. Defaults to the
# directory you ran ./docker/run.sh from.
# WORKER_WORKSPACE=/absolute/path/to/project

# ── Optional: image + container naming ──────────────────────────────────────
# SUITE_WORKER_IMAGE=claude-code-suite-worker:latest
# SUITE_WORKER_CONTAINER=suite-worker-${SUITE_RUNTIME_ID}

# ── Optional: extra bind mounts ─────────────────────────────────────────────
# Space-separated list of docker mount specs (sans type=bind).
# Example:   SUITE_WORKER_EXTRA_MOUNTS="source=/Users/me/shared,target=/shared source=/etc/ssl/certs,target=/etc/ssl/certs,readonly"
# SUITE_WORKER_EXTRA_MOUNTS=
